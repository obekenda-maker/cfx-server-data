# =====================================================================
#  secrets.cfg – NOOIT COMMITTEN. Maak dit bestand zelf aan op de server.
#  Gebruik `set` (NIET `setr`): `setr` zou de waarde naar alle spelers sturen!
# =====================================================================

# Licentiesleutel: https://portal.cfx.re/servers/registration-keys
sv_licenseKey "cfxk_VERVANG_DIT"

# oxmysql connection string (uri-formaat). Speciale tekens in het wachtwoord URL-encoden.
set mysql_connection_string "mysql://esx_nl:WACHTWOORD@127.0.0.1/esx_nl?charset=utf8mb4"

# Discord-webhooks (leeg laten = kanaal uitgeschakeld; 'general' is de terugval)
set dc_webhook_general    ""
set dc_webhook_admin      ""
set dc_webhook_money      ""
set dc_webhook_combat     ""
set dc_webhook_gang       ""
set dc_webhook_suspicious ""
